# Web mode: public HTTPS origin (no trailing path).
domain=http://127.0.0.1:8000
# Set SERVER_PORT if required by your hosting environment. Local default: 8000.
# SERVER_PORT=8000
log_to_console=false

# Web mode does not need cookie-encryption keys or Trakt OAuth credentials.
# Each user enters their PMDB key in the web UI; it stays in process memory.

# CLI mode only (user.py); never commit real values:
# pmdb_api_key=
# trakt_client=
# trakt_secret=
